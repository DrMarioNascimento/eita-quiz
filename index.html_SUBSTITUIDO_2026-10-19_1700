<script>
(function(){
  const ov=document.getElementById('introOverlay');
  const v=document.getElementById('introVid');
  if(!ov||!v) return;
  function hide(){ov.style.opacity='0';setTimeout(()=>ov.remove(),600);}
  v.addEventListener('ended',()=>{sessionStorage.setItem('eitaIntroSeen','1');hide();});
  v.addEventListener('error',hide);
  if(sessionStorage.getItem('eitaIntroSeen')){hide();return;}
  // try autoplay; if blocked, show a play button
  v.muted=false;
  const p=v.play();
  if(p&&p.catch){
    p.catch(()=>{
      const btn=document.createElement('button');
      btn.textContent='▶ Iniciar';
      btn.style.cssText='position:absolute;inset:0;margin:auto;width:180px;height:60px;font-size:22px;background:#ff8c00;color:#000;border:none;border-radius:30px;cursor:pointer;z-index:2;';
      ov.appendChild(btn);
      btn.onclick=()=>{btn.remove();v.play();};
    });
  }
  // do NOT hide on click or key — only on ended
})();
</script>
