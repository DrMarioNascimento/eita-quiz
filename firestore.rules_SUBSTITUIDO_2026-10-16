rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function teacher(){return signed() && request.auth.token.firebase.sign_in_provider == 'google.com';}
  function room(code){return get(/databases/$(database)/documents/rooms/$(code)).data;}
  function owner(code){return signed() && room(code).owner == request.auth.uid;}
  function validRoom(d){return d.keys().hasAll(['owner','status','round','question','result','paused','deadline','createdAt','expiresAt','participants','groups','mode']) && d.keys().hasOnly(['owner','status','round','question','result','paused','deadline','createdAt','expiresAt','participants','groups','mode']) && d.owner is string && d.status in ['waiting','question','resolving','result','ended','closed'] && d.round is int && d.round >= 0 && d.paused is bool && d.deadline is timestamp && d.createdAt is timestamp && d.expiresAt is timestamp && d.participants is list && d.participants.size() <= 60 && d.groups is list && d.mode in ['individual','shared','own'];}
  function validMember(d){return d.keys().hasAll(['name','emoji','joinedAt']) && d.keys().hasOnly(['name','emoji','joinedAt']) && d.name is string && d.name.size()>0 && d.name.size()<=30 && d.emoji is string && d.emoji.size()>0 && d.emoji.size()<=12 && d.joinedAt == request.time;}
  function validAnswer(d){return d.keys().hasAll(['uid','round','choice','submittedAt']) && d.keys().hasOnly(['uid','round','choice','submittedAt']) && d.uid==request.auth.uid && d.round is int && d.choice is int && d.choice>=0 && d.choice<4 && d.submittedAt == request.time;}
  match /rooms/{code} {
   allow get: if signed();
   allow list: if false;
   allow create: if teacher() && code.matches('[0-9]{6}') && validRoom(request.resource.data) && request.resource.data.owner==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.expiresAt>request.time && request.resource.data.expiresAt<=request.time+duration.value(25,'h') && request.resource.data.status=='waiting';
   allow update: if owner(code) && validRoom(request.resource.data) && request.resource.data.owner==resource.data.owner && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.expiresAt==resource.data.expiresAt;
   match /members/{uid} {
    allow get: if signed() && (request.auth.uid==uid || owner(code));
    allow list: if owner(code);
    allow create: if signed() && uid==request.auth.uid && validMember(request.resource.data) && room(code).status=='waiting' && room(code).expiresAt>request.time;
   }
   match /answers/{answer} {
    allow get: if signed() && (owner(code) || resource.data.uid==request.auth.uid);
    allow list: if owner(code);
    allow create: if signed() && validAnswer(request.resource.data) && answer==string(request.resource.data.round)+'_'+request.auth.uid && room(code).status=='question' && !room(code).paused && room(code).round==request.resource.data.round && request.auth.uid in room(code).participants && room(code).deadline>request.time && room(code).expiresAt>request.time;
   }
  }
 }
}
