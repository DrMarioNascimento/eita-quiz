    font-size: 12px;
  }
}
.boss-side {
  grid-column: 1;
  grid-row: 1;
}
.team-side {
  grid-column: 2;
  grid-row: 1;
}
#students.students {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
