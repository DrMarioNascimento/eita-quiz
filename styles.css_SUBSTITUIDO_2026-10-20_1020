.sheet-report:not(:empty){padding:8px 10px!important;border-radius:8px;background:#ffffff0d}
.sheet-report[data-kind=erro]{background:#c0000033!important;color:#ffd0d0!important}
.sheet-report[data-kind=aviso]{background:#ffc00026!important;color:#ffe2a6!important}
