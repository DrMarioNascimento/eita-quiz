.arena .beam {
  height: 22px;
  left: 20%;
  right: 20%;
  z-index: 12;
}
.arena.counter .beam {
  height: 26px;
  background: linear-gradient(0deg,#0aa989,#b6fff1 35%,#ffffff 50%,#b6fff1 65%,#0aa989);
  box-shadow: 0 0 12px 6px #a6ffed,0 0 35px 15px #12dca8,0 0 70px #08abcc;
  animation: beam-left 1.1s ease-out;
}
.arena.counter .beam:before,.arena.counter .beam:after {
  content: '';
  position: absolute;
  inset: -16px -10px;
  border-radius: 50%;
  border: 2px solid #9effe8;
  box-shadow: 0 0 20px #42ffdf;
  animation: shot-wave 1.1s ease-out;
}
.arena.counter .beam:after {
  inset: -30px -25px;
  animation-delay: .1s;
}
.boss.video-active:after {
  opacity: 1;
  inset: 30% -8% 20% 38%;
  background: radial-gradient(ellipse at 60% 55%,#fff5bb88,#ffaa3855 20%,#ff6a1529 40%,transparent 70%);
  filter: blur(12px);
  mix-blend-mode: screen;
  animation: muzzle-glow .2s infinite alternate;
  z-index: 4;
}
.boss video {
  mask-image: linear-gradient(90deg,transparent,#000 7%,#000 86%,transparent),linear-gradient(0deg,transparent,#000 5%,#000 94%,transparent);
  mask-composite: intersect;
  -webkit-mask-image: linear-gradient(90deg,transparent,#000 7%,#000 86%,transparent),linear-gradient(0deg,transparent,#000 5%,#000 94%,transparent);
  -webkit-mask-composite: source-in;
}
.boss.firing {
  overflow: visible;
}
.shatter-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 20;
  overflow: visible;
}
.shard {
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--w);
  height: var(--w);
