@media(max-width:480px) {
  #students.students {
    gap: 5px;
  }
  .groups .students {
    gap: 4px;
  }
}
.boss-side {
  display: flex;
  flex-direction: column;
  align-self: stretch;
}
.boss {
  width: 100%;
}
.boss-side>small {
  margin-top: 12px;
}
.boss img {
  object-fit: contain;
  object-position: center;
}
.question {
  box-shadow: inset 0 2px 0 #9acde229,inset 0 -5px 10px #0005,0 12px 24px #0005;
}
.option {
  background: linear-gradient(155deg,#344a66,#1d304c);
  box-shadow: inset 0 2px 1px #b9d9ff26,inset 0 -4px 5px #0004,0 5px 8px #0004;
}
.option.correct {
  background: linear-gradient(155deg,#227e60,#124c3b);
}
button {
  background: linear-gradient(#3b5275,#213552);
  box-shadow: inset 0 2px 0 #ffffff21,0 4px 0 #080f20,0 7px 12px #0003;
  transition: transform .15s;
}
button:active:not(:disabled) {
  transform: translateY(2px);
}
button.primary {
  background: linear-gradient(#ffc16b,#f09325);
  box-shadow: inset 0 2px 0 #ffdda1,0 4px 0 #875315,0 7px 12px #0004;
}
#teamBattery {
  border-style: ridge;
}
.boss.hit {
  animation: boss-hit .7s ease-in-out;
}
.arena .beam {
  position: absolute;
  top: 55%;
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
  background: linear-gradient(90deg,#ff6b19,#fff3a2);
  box-shadow: 0 0 12px #ffab24,0 0 35px #ff6b19;
}
.arena.firing .beam {
  animation: beam-right .8s ease-out;
}
@keyframes fire {
  30% {
    transform: translateX(-7px) scale(.97);
  }
  65% {
    transform: translateX(10px) scale(1.03);
    filter: brightness(1.5);
  }
}
@keyframes boss-hit {
  20%,60% {
    transform: translateX(-10px);
    filter: brightness(2);
  }
  40%,80% {
    transform: translateX(5px);
  }
}
@keyframes beam-right {
  0% {
    opacity: 0;
    transform: scaleX(.05);
    transform-origin: left;
  }
  40% {
    opacity: 1;
    transform: scaleX(1);
    transform-origin: left;
  }
  100% {
    opacity: 0;
    transform: scaleX(1);
  }
}
@keyframes beam-left {
  0% {
    opacity: 0;
    transform: scaleX(.05);
    transform-origin: right;
  }
  40% {
    opacity: 1;
    transform: scaleX(1);
    transform-origin: right;
  }
  100% {
    opacity: 0;
    transform: scaleX(1);
  }
}
@media(prefers-reduced-motion:reduce) {
  .boss,.beam {
    animation: none!important;
  }
}
.boss .charge {
  mix-blend-mode: screen;
