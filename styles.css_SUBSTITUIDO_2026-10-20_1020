@media(max-width:600px){.brand{gap:12px}.brand h1{font-size:42px}.brand-tagline{font-size:20px}header{gap:15px;flex-wrap:wrap}}
/* Linhas partem da direita ao fundo e chegam à esquerda na frente. */
.arena:before {
  background-image: linear-gradient(90deg, #50ccdf66 1px, transparent 1px), linear-gradient(0deg, #48c6d944 1px, transparent 1px);
  background-size: 62px 62px;
  transform: perspective(560px) rotateX(62deg) skewX(-42deg);
  transform-origin: center top;
}

/* Diagonal do canto inferior direito ao superior esquerdo. */
.arena:before { transform: perspective(560px) rotateX(62deg) skewX(42deg); }

/* Inclinação mais acentuada, mantendo a direção aprovada. */
.arena:before { transform: perspective(560px) rotateX(62deg) skewX(50deg); }
/* A arena deixa aparecer a fotografia contínua do fundo. */
.arena {
  background: linear-gradient(180deg, rgba(35, 78, 103, .26), rgba(22, 64, 82, .18) 48%, rgba(16, 49, 66, .24));
}
.arena:after {
  background: none;
  mask-image: none;
  -webkit-mask-image: none;
}

/* Escala do personagem pela altura da pilha, com proporção original do WebM. */
.boss video{width:var(--character-frame-width,100%);height:var(--character-frame-height,100%);left:50%;right:auto;bottom:var(--character-frame-bottom,0px);transform:translateX(-38%)!important;object-fit:fill;max-width:none}
.arena.counter .beam{top:var(--student-shot-y,55%);left:var(--student-shot-x,24%);width:var(--student-shot-length,45%);right:auto;transform:translateY(-50%)}

/* Centro do personagem recalculado junto da escala e da largura disponível. */
.boss video{left:var(--character-frame-left,50%);transform:none!important}

/* Resultado ocupa o espaço preservado do lado derrotado. */
.battle-verdict{position:absolute;z-index:20;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;box-sizing:border-box;pointer-events:none;font-family:"Arial Black","Segoe UI",sans-serif;font-weight:950;font-style:italic;font-size:clamp(32px,5vw,78px);line-height:1.1;letter-spacing:-.04em;overflow-wrap:normal;color:#eaffc6;text-shadow:2px 3px 0 #365d18,4px 6px 0 #173344,0 0 8px #c8ff50,0 0 25px #68ff76,0 0 50px #00d6ff;animation:verdict-arrive 1s cubic-bezier(.16,1,.3,1) both,verdict-glow 2.5s 1s ease-in-out infinite}
.battle-verdict.defeat{color:#ffe5d4;text-shadow:2px 3px 0 #a63626,4px 6px 0 #48172c,0 0 8px #ffb064,0 0 25px #ff422f,0 0 50px #ff6a24}
@keyframes verdict-arrive{0%{opacity:0;transform:scale(.08) translateY(-40px);filter:blur(10px);letter-spacing:.25em}70%{opacity:1;transform:scale(1.06);filter:blur(0)}100%{opacity:1;transform:scale(1);letter-spacing:-.04em}}
@keyframes verdict-glow{50%{filter:brightness(1.25)}}
@media(prefers-reduced-motion:reduce){.battle-verdict{animation:none}}

.header-actions{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.fullscreen-button{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:9px;border:1px solid #84c4d0;border-radius:12px;background:linear-gradient(145deg,#36566b,#132c40);color:#dcfaff;box-shadow:inset 0 2px 1px #ffffff33,0 3px 0 #081725;cursor:pointer}
.fullscreen-button:hover{background:linear-gradient(145deg,#47748b,#1a3a50);box-shadow:inset 0 2px 1px #ffffff33,0 0 12px #6ae9ff55}
.fullscreen-button:focus-visible{outline:2px solid #bcf8ff;outline-offset:4px}
#fullscreenNotice{font-size:12px;color:#ffd7a0}

.room-qr-dialog{width:min(520px,90vw);text-align:center;background:linear-gradient(145deg,#244456,#101d32);color:#e9fcff;border:2px solid #8de2ec;border-radius:24px;box-shadow:0 0 40px #57dcff55;padding:26px;box-sizing:border-box}
.room-qr-dialog::backdrop{background:#03101bd9;backdrop-filter:blur(6px)}
#roomQr{width:min(300px,65vw);margin:20px auto;background:white;border:10px solid white;border-radius:12px;box-sizing:border-box}
#roomQr svg{display:block;width:100%;height:auto}
#qrRoomCode{display:block;font-size:42px;letter-spacing:.15em;color:#ccff64}

/* Mesmo desenho energético em ambos os ataques, cores distintas. */
.boss-shot{position:absolute;z-index:14;height:26px;pointer-events:none;transform-origin:0 50%;border-radius:50%;display:none;background:linear-gradient(0deg,#b01432,#ff9aab 35%,#fff6ef 50%,#ff9aab 65%,#b01432);box-shadow:0 0 12px 6px #ff8c9c,0 0 35px 15px #ed234e,0 0 70px #ff263c;clip-path:inset(-80px calc((1 - var(--shot-arrival,0))*100%) -80px -35px)}
.boss-shot.active{display:block}
.boss-shot:before,.boss-shot:after{content:'';position:absolute;inset:-16px -10px;border-radius:50%;border:2px solid #ffb8bc;box-shadow:0 0 20px #ff4265}
.boss-shot:after{inset:-30px -25px;opacity:.6}
.arena.counter .beam{background:linear-gradient(0deg,#278b25,#cbff80 35%,#ffffff 50%,#cbff80 65%,#278b25);box-shadow:0 0 12px 6px #d5ff95,0 0 35px 15px #8df431,0 0 70px #19cb85}
.arena.counter .beam:before,.arena.counter .beam:after{border-color:#d9ff9b;box-shadow:0 0 20px #98ff46}

/* Geometria única dos dois disparos: apenas a paleta muda. */
.arena.counter .beam,.boss-shot{height:26px;border-radius:50%;background:linear-gradient(0deg,var(--shot-dark),var(--shot-light) 35%,#fff 50%,var(--shot-light) 65%,var(--shot-dark));box-shadow:0 0 12px 6px var(--shot-light),0 0 35px 15px var(--shot-color),0 0 70px var(--shot-color);animation:energy-shot-pulse .22s linear infinite}
.arena.counter .beam{--shot-dark:#278b25;--shot-light:#cbff80;--shot-color:#8df431;--shot-fade:1;opacity:1}
.boss-shot{--shot-dark:#b01432;--shot-light:#ff9aab;--shot-color:#ed234e}
.arena.counter .beam:before,.arena.counter .beam:after,.boss-shot:before,.boss-shot:after{content:'';position:absolute;inset:-16px -10px;border-radius:50%;border:2px solid var(--shot-light);box-shadow:0 0 20px var(--shot-color);animation:shot-wave 1.1s ease-out infinite;animation-delay:0s;opacity:1}
.arena.counter .beam:after,.boss-shot:after{inset:-30px -25px;animation-delay:.1s;opacity:1}
@keyframes energy-shot-pulse{0%,100%{opacity:calc(var(--shot-fade,1)*.85)}50%{opacity:var(--shot-fade,1)}}
/* As duas carcaças se assentam na mesma base da terceira linha. */
.boss{align-self:end}
.battery-shell:before{box-sizing:border-box;left:38%;width:24%;height:24px;top:-3px;border:2px solid #9abec8;border-top-color:#ddf4f5;border-radius:7px 7px 0 0;background:linear-gradient(90deg,#294c60,#7cbecb 28%,#d5f6f6 48%,#6ca3b8 70%,#264657);box-shadow:inset 0 2px 0 #ffffff66,inset 0 -3px 4px #183445aa,3px 2px 0 #193344}
.charge-terminal{bottom:calc(var(--team-battery-height,410px) - 5px)}

/* A base fica fixa; somente os pontos acima dela se deslocam à esquerda. */
.arena:before{transform:translateX(var(--floor-shear-offset,0px)) matrix(1,0,.70,1,0,0) perspective(560px) rotateX(62deg) skewX(50deg);transform-origin:center top}

.brand h1{color:#f09325;background:linear-gradient(#ffc16b,#f09325);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-shadow:0 2px 1px #ad651a55,2px 5px 8px #0006}
.author-credit{text-align:right;margin-top:22px;padding:12px 0 2px;color:#d5e1f0;font-size:14px;text-shadow:0 2px 3px #0008}

/* Cabeçalho com emblema alpha e exclamação com preenchimento próprio. */
.brand-emblem{display:block;width:72px;height:72px;object-fit:contain;filter:drop-shadow(0 0 5px #ffc16bcc) drop-shadow(0 0 14px #f0932580) drop-shadow(0 0 24px #f0932540);flex:none}
.brand h1{background:none;-webkit-text-fill-color:initial;color:#ffc16b;text-shadow:none;filter:drop-shadow(0 2px 0 #a65c1b) drop-shadow(1px 4px 4px #0005);display:flex;align-items:baseline;overflow:visible;padding-right:12px}
.brand-word{display:inline-block;padding-right:3px;background:linear-gradient(#ffc16b,#f09325);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.brand-exclamation{display:inline-block;color:#ffc16b;-webkit-text-fill-color:#ffc16b;background:none;padding:0 8px 0 1px}
@media(max-width:600px){.brand-emblem{width:56px;height:56px}.brand{gap:12px}}
/* Diagonais explícitas: as pontas superiores ficam sempre à esquerda das bases. */
.arena-floor{position:absolute;left:0;top:48%;width:100%;height:52%;z-index:0;pointer-events:none;overflow:hidden}
.arena-floor line{fill:none;stroke:#50ccdf66;stroke-width:1;vector-effect:non-scaling-stroke}
.arena-floor .floor-crosslines line{stroke:#48c6d944}
.arena:before{left:0;right:0;top:48%;bottom:auto;height:2px;transform:none;background:#66deed99;box-shadow:0 -2px 4px #a6faffcc,0 -4px 16px #38e4ffaa,0 -9px 35px #24cbef66;opacity:.9}

.brand-emblem{width:120px;height:120px}
@media(max-width:600px){.brand-emblem{width:90px;height:90px}}

/* Brilho no contorno alpha do emblema, sem alterar suas dimensões. */
.brand-emblem{filter:drop-shadow(0 0 2px #ffe2a0) drop-shadow(0 0 6px #ffc16b) drop-shadow(0 0 13px #f09325cc) drop-shadow(0 0 23px #f0932577)}

/* ===== Chefes por partida: fundo, projétil do golpe e impacto (catálogo em chefes.js) ===== */
main.fundo-chefe{background-size:cover;background-position:center center;background-repeat:no-repeat}
main.fundo-chefe .arena-floor,main.fundo-chefe .arena:before{display:none}
.boss-projectile{position:absolute;z-index:14;left:0;top:0;display:none;pointer-events:none;--golpe-cor:#ffb347;--golpe-t:0;transform:translate(-50%,-50%) rotate(var(--golpe-angulo,0rad))}
.boss-projectile.active{display:block}
.boss-projectile.tipo-flecha{width:clamp(110px,11vw,190px);height:clamp(10px,1vw,16px);border-radius:50%;background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--golpe-cor) 55%,transparent) 35%,var(--golpe-cor) 75%,#fff 94%,#fff);box-shadow:0 0 14px 4px var(--golpe-cor),0 0 40px 10px color-mix(in srgb,var(--golpe-cor) 60%,transparent);transform:translate(-80%,-50%) rotate(var(--golpe-angulo,0rad))}
.boss-projectile.tipo-flecha:after{content:'';position:absolute;right:-6px;top:50%;width:26px;height:26px;border-radius:50%;transform:translateY(-50%);background:radial-gradient(circle,#fff 0 30%,var(--golpe-cor) 60%,transparent 72%);box-shadow:0 0 22px 8px var(--golpe-cor)}
.boss-projectile.tipo-corte{width:clamp(70px,6.5vw,120px);height:clamp(150px,14vw,250px);border-radius:50%;border-right:clamp(10px,1vw,16px) solid #fff;box-shadow:inset -10px 0 18px -4px var(--golpe-cor),12px 0 22px -6px var(--golpe-cor);filter:drop-shadow(0 0 10px var(--golpe-cor)) drop-shadow(0 0 26px var(--golpe-cor));transform:translate(-50%,-50%) rotate(var(--golpe-angulo,0rad)) scale(calc(.75 + var(--golpe-t) * .55));opacity:calc(1 - var(--golpe-t) * .15)}
.boss-projectile.tipo-corte:before{content:'';position:absolute;inset:14% 18% 14% -26%;border-radius:50%;border-right:6px solid var(--golpe-cor);opacity:.55;filter:blur(2px)}
.boss-projectile.tipo-pow{width:clamp(90px,8vw,150px);height:clamp(90px,8vw,150px);transform:translate(-50%,-50%) rotate(calc(var(--golpe-t) * 260deg)) scale(calc(.6 + var(--golpe-t) * .7));filter:drop-shadow(0 0 14px var(--golpe-cor))}
.boss-projectile.tipo-pow:before,.boss-projectile.tipo-pow:after{content:'';position:absolute;inset:0;clip-path:polygon(50% 0,59% 30%,85% 12%,72% 40%,100% 45%,74% 58%,92% 86%,62% 72%,50% 100%,40% 72%,10% 88%,27% 58%,0 46%,28% 40%,14% 12%,41% 30%)}
.boss-projectile.tipo-pow:before{background:#1a0d02;transform:scale(1.14)}
.boss-projectile.tipo-pow:after{background:radial-gradient(circle,#fff 0 16%,#ffe84d 30%,var(--golpe-cor) 58%,#e0261b 80%)}
.golpe-impacto{position:absolute;z-index:15;width:clamp(160px,15vw,280px);height:clamp(160px,15vw,280px);pointer-events:none;transform:translate(-50%,-50%);--golpe-cor:#ffb347}
.golpe-impacto,.golpe-impacto:before,.golpe-impacto:after{border-radius:50%}
.golpe-impacto{background:radial-gradient(circle,#fff 0 12%,var(--golpe-cor) 34%,color-mix(in srgb,var(--golpe-cor) 40%,transparent) 52%,transparent 70%);animation:golpe-flash .75s ease-out forwards}
.golpe-impacto:before{content:'';position:absolute;inset:0;border:5px solid #fff;box-shadow:0 0 18px 6px var(--golpe-cor),inset 0 0 18px 6px var(--golpe-cor);animation:golpe-onda .75s ease-out forwards}
.golpe-impacto:after{content:'';position:absolute;inset:-20%;border-radius:0;background:repeating-conic-gradient(from 8deg,#fff 0 4deg,transparent 4deg 30deg);-webkit-mask:radial-gradient(circle,transparent 0 28%,#000 30% 48%,transparent 62%);mask:radial-gradient(circle,transparent 0 28%,#000 30% 48%,transparent 62%);animation:golpe-raios .6s ease-out forwards}
@keyframes golpe-flash{0%{transform:translate(-50%,-50%) scale(.25);opacity:1}35%{opacity:1}100%{transform:translate(-50%,-50%) scale(1.35);opacity:0}}
@keyframes golpe-onda{0%{transform:scale(.2);opacity:1}100%{transform:scale(1.6);opacity:0}}
@keyframes golpe-raios{0%{transform:scale(.4) rotate(0);opacity:1}100%{transform:scale(1.5) rotate(25deg);opacity:0}}
.battery-shell.impacto{animation:golpe-tremor .5s cubic-bezier(.36,.07,.19,.97)}
@keyframes golpe-tremor{0%,100%{transform:translate(0,0);filter:none}10%{transform:translate(12px,-3px);filter:brightness(1.8)}25%{transform:translate(-10px,3px);filter:brightness(1.4)}40%{transform:translate(8px,-2px)}55%{transform:translate(-6px,2px)}70%{transform:translate(4px,0)}85%{transform:translate(-2px,0)}}
@media (prefers-reduced-motion:reduce){.battery-shell.impacto{animation:none}}

/* ===== Menu esquerdo: blocos Preparar · Jogar · Apoio (2026-10-19) ===== */
.menu-group{margin:18px 2px 8px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8fa9c4}
.menu-group:first-child{margin-top:0}
.menu-step{--step-color:#3fd0b0;padding:0;margin:0 0 10px;border-left:4px solid var(--step-color);overflow:hidden}
.menu-step.step-play{--step-color:#ffc16b}
