/* ===== Controle da partida: cápsula de botões no estilo do Biofeedback Respiratório, cores do Eita! (2026-10-19) ===== */
.control-capsule{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:10px;padding:12px;background:linear-gradient(#08111b,#192a37);border:1px solid #344957;border-radius:20px;box-shadow:inset 0 3px 8px #0009,0 1px 0 #fff2}
.capsule-btn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;width:100%;min-height:70px;margin:0!important;padding:8px 4px;font-size:12px!important;line-height:1.15;font-weight:600;text-align:center;color:#e6f2ff;border:1px solid #5b7184;border-radius:13px;background:linear-gradient(165deg,#4a6276,#263c4f 48%,#172b3c);box-shadow:inset 0 2px 1px #ffffff38,inset 0 -2px 2px #0007,0 5px 0 #070f18,0 8px 10px #0008;text-shadow:0 1px 2px #000;transition:transform .14s,filter .14s,box-shadow .14s}
.capsule-btn:hover:enabled{filter:brightness(1.16);transform:translateY(-1px)}
.capsule-btn:active:enabled{transform:translateY(4px);box-shadow:inset 0 2px 5px #0005,0 1px 0 #040c13}
.capsule-btn:disabled{opacity:.38;cursor:default}
.capsule-btn:before{content:'';display:block;flex:none;font-size:22px;line-height:1}
#start.capsule-btn{grid-column:1/-1;flex-direction:row;gap:12px;min-height:58px;font-size:17px!important;font-weight:800;white-space:nowrap;color:#2b1602;text-shadow:0 1px 0 #ffe2ad;border-color:#ffcf86;background:linear-gradient(155deg,#ffe0a3,#f0a03d 48%,#b4651a);box-shadow:inset 0 2px 1px #ffffff70,inset 0 -2px 2px #0005,0 5px 0 #5a2c06,0 8px 12px #0008}
#start.capsule-btn:before{content:'\25B6\FE0E';font-size:22px}
#pause.capsule-btn:before{width:16px;height:20px;box-sizing:border-box;border-left:5px solid currentColor;border-right:5px solid currentColor}
#pause.capsule-btn[data-icon=play]:before{width:auto;height:auto;border:0;content:'\25B6\FE0E';color:#9ff0c9}
#finish.capsule-btn{color:#ffd9a3}
#finish.capsule-btn:before{width:17px;height:17px;border-radius:3px;background:currentColor}
#reset.capsule-btn{color:#ffc2b6}
#reset.capsule-btn:before{content:'\21BB';font-size:24px;font-weight:700}
@media(prefers-reduced-motion:reduce){.capsule-btn{transition:none}}

/* ===== Etapas 1–4: número à esquerda e ícone centralizado na 1ª linha; nome na 2ª linha (2026-10-19) ===== */
.step-prep>summary,.step-play>summary{position:relative;display:grid;grid-template-columns:1fr auto 1fr;grid-template-areas:"num icon end" "text text text";align-items:center;row-gap:8px;padding:14px 14px 12px}
.step-prep>summary .step-num,.step-play>summary .step-num{grid-area:num;justify-self:start}
.step-prep>summary .step-icon,.step-play>summary .step-icon{grid-area:icon;width:56px;height:56px}
.step-prep>summary .step-text,.step-play>summary .step-text{grid-area:text;text-align:center}
.step-prep>summary .step-text h2,.step-play>summary .step-text h2{font-size:16px}
.step-prep>summary .step-badge,.step-play>summary .step-badge{grid-area:end;justify-self:end;margin-right:24px}
.step-prep>summary .step-chevron,.step-play>summary .step-chevron{position:absolute;top:22px;right:16px;margin:0}
.step-prep[open]>summary .step-chevron,.step-play[open]>summary .step-chevron{top:26px}

/* Screen-sized battle area; roster density never determines boss size. */
main{grid-template-columns:310px minmax(0,1fr);min-height:calc(100dvh - var(--game-header-height,160px))}
main>section{display:flex;flex-direction:column;gap:12px;min-width:0}
.question{position:relative;flex:none;margin:0;padding:18px 22px}
.question h2{min-height:0;margin:6px 0 12px}
.question .options:empty{display:none;min-height:0}
.question .result-card{margin:8px 0 0;padding:0;border:0;background:none;box-shadow:none}
.question .status{min-height:0;font-size:15px;padding:0}
.question .log:empty,.question #transition:empty{display:none}
.question #transition{margin:5px 0}
.question .timer{height:44px;min-height:44px;min-width:150px;margin-top:10px;font-size:21px}
.arena{flex:none;padding:16px;gap:20px;--battle-height:410px}
.team-side,.boss-side{grid-template-rows:auto 105px var(--battle-height);align-items:stretch;row-gap:8px}
.boss-art,.team-art,.boss-art .meter-frame,.team-art .meter-frame{height:105px}
.boss-art .art-slot,.team-art .art-slot{top:64.5px;height:11px}
.boss{height:var(--battle-height);min-height:0;align-self:stretch}
.battery-shell{height:var(--battle-height);width:100%;max-width:none;padding-top:0;align-self:stretch}
#teamBattery{height:100%;min-height:0;padding:12px;margin:0}
#teamBattery>.content{height:100%;min-height:0;gap:8px;justify-content:stretch;overflow:auto;scrollbar-width:thin}
#students.students{display:grid;grid-template-columns:repeat(var(--roster-columns,1),minmax(0,1fr));grid-template-rows:repeat(var(--roster-rows,1),minmax(72px,1fr));gap:8px;flex:1;min-height:0}
#students:empty{display:none}
#students .student{min-height:72px;padding:6px;min-width:0;gap:5px}
#students .animal-avatar{width:var(--avatar-size,70px);height:var(--avatar-size,70px);max-width:100%;flex-shrink:0}
#students .student-name{font-size:var(--roster-font,13px);overflow-wrap:anywhere;line-height:1.2}
#teamBattery.has-squads #students{display:block;flex:none;font-size:12px;text-align:center}
#groups{flex:1;min-height:0;grid-template-columns:repeat(var(--roster-columns,1),minmax(0,1fr));grid-template-rows:repeat(var(--roster-rows,1),minmax(160px,1fr));gap:8px}
#groups:empty{display:none}
#groups>.battery{min-height:160px;padding:8px;overflow:auto}
#groups .content{height:100%;display:flex;flex-direction:column;gap:4px;justify-content:flex-start}
#groups .content>*{flex-shrink:0}
#groups .squad-emblem{margin:0}
#groups .squad-emblem .animal-icon{width:var(--avatar-size,70px);height:var(--avatar-size,70px);max-width:100%}
#groups .content strong{min-height:0;margin:0;font-size:clamp(12px,var(--roster-font,14px),18px);line-height:1.2}
#groups .content small{min-height:0;margin:0;font-size:11px}
#groups .students{grid-template-columns:repeat(auto-fit,minmax(65px,1fr));margin:0;gap:3px;flex:none;min-height:0}
#groups .squad-member{font-size:12px;overflow-wrap:anywhere;padding:3px;line-height:1.2}
.author-credit{flex:none;margin:0;padding:4px 0 0;font-size:12px}
@media(max-width:850px){
 main{grid-template-columns:1fr}
 .arena{padding:12px;gap:12px}
 .team-side,.boss-side{grid-template-rows:auto 85px var(--battle-height)}
 .boss-art,.team-art,.boss-art .meter-frame,.team-art .meter-frame{height:85px}
 .boss-art .art-slot,.team-art .art-slot{top:52px;height:9px}
}
@media(max-width:480px){
 main>section{padding:10px}
 .question{padding:12px}
 .arena{padding:10px 6px;gap:10px}
 #teamBattery{padding:6px}
 .battle-label{font-size:10px;letter-spacing:0}
}

/* Preserve the source frame proportions and expose both battery terminals. */
.team-side,.boss-side{grid-template-rows:auto auto var(--battle-height)}
.boss-art,.team-art{width:100%;max-width:520px;height:auto;aspect-ratio:2068 / 760;align-self:start}
.boss-art .meter-frame,.team-art .meter-frame{inset:0;top:0;width:100%;height:100%}
.boss-art .art-slot,.team-art .art-slot{top:61.4815%;height:10.3704%}
.battery-shell:before{top:-19px;height:24px;z-index:1}
#teamBattery{z-index:2}

/* Compact transport capsule, matching the respiratory biofeedback controls. */
.control-capsule{grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;padding:8px;margin-top:8px;border-radius:17px;max-width:260px}
.control-capsule .capsule-btn,.control-capsule #start.capsule-btn{grid-column:auto;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:0;width:100%;height:42px;min-height:42px;min-width:0;margin:0!important;padding:6px;font-size:0!important;border-radius:11px}
.control-capsule .capsule-btn:before,.control-capsule #start.capsule-btn:before{font-size:20px;line-height:1}
.control-capsule #pause.capsule-btn:before{width:14px;height:17px;border-left-width:4px;border-right-width:4px}
.control-capsule #pause.capsule-btn[data-icon=play]:before{width:auto;height:auto;border:0}
.control-capsule #finish.capsule-btn:before{width:15px;height:15px}
.control-capsule .capsule-btn:focus-visible{outline:2px solid #ffe0a3;outline-offset:3px}
.fullscreen-button{width:40px;height:40px;margin-top:0;padding:8px;border-radius:11px}
:is(#menu-entrada,#menu-montagem,#menu-config,#menu-controle)>summary{display:flex;min-height:50px;gap:9px;padding:10px 12px}
:is(#menu-entrada,#menu-montagem,#menu-config,#menu-controle)>summary .step-icon{width:28px;height:28px}
:is(#menu-entrada,#menu-montagem,#menu-config,#menu-controle)>summary .step-text{text-align:left}
:is(#menu-entrada,#menu-montagem,#menu-config,#menu-controle)>summary .step-text h2{font-size:14px}
:is(#menu-entrada,#menu-montagem,#menu-config,#menu-controle)>summary .step-chevron{position:static;margin:0 2px 4px}
:is(#menu-entrada,#menu-montagem,#menu-config,#menu-controle)>summary .step-badge{margin:0;font-size:10px;padding:2px 5px}
html.eita-fs #menu-controle{border:0;background:transparent!important;box-shadow:none}
html.eita-fs #menu-controle>summary{display:none}
html.eita-fs #menu-controle>.step-body{padding:0}
html.eita-fs .control-capsule{grid-template-columns:repeat(5,minmax(0,1fr));margin:0;max-width:280px}
html.eita-fs .control-capsule .fs-exit{display:flex;color:#dcfaff}
.control-capsule .fs-exit:before{content:'\2922';font-size:24px}

/* Short visible labels keep the compact controls easy to identify. */
.control-capsule .capsule-btn,.control-capsule #start.capsule-btn{flex-direction:column;gap:3px;height:50px;min-height:50px;padding:5px 2px}
.control-capsule .capsule-btn:after{content:attr(data-short-label);display:block;font-size:10px;font-weight:650;line-height:1;white-space:nowrap;letter-spacing:-.15px}
.fullscreen-button{flex-direction:column;gap:2px;height:50px;width:50px;padding:5px}
.fullscreen-button:after{content:'Tela cheia';display:block;font-size:9px;line-height:1;white-space:nowrap}
.fullscreen-button[aria-pressed=true]:after{content:'Sair'}


