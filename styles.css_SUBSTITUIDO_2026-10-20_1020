/* Eita! — interface e animações. */
:root {
  color-scheme: dark;
  font-family: system-ui,sans-serif;
  background: #080e1b;
  color: #eef4ff;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
}
header {
  padding: 20px 30px;
  border-bottom: 1px solid #27334b;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
h1 {
  margin: 0;
  color: #ffad48;
  font-size: 34px;
}
small,.muted {
  color: #9fb0c9;
}
main {
  display: grid;
  grid-template-columns: 310px 1fr;
  min-height: calc(100vh - 90px);
}
aside {
  padding: 22px;
  background: #10192b;
  border-right: 1px solid #27334b;
}
label {
  display: block;
  font-size: 13px;
  margin: 16px 0 7px;
}
input,select,textarea,button {
  font: inherit;
  border-radius: 9px;
  border: 1px solid #374460;
  padding: 10px;
  background: #17243b;
  color: inherit;
  width: 100%;
}
textarea {
  resize: vertical;
}
button {
  cursor: pointer;
  margin-top: 9px;
}
button.primary {
  color: #211509;
  font-weight: 750;
  border: 0;
}
button:disabled {
  opacity: .4;
  cursor: default;
}
section {
  padding: 25px;
  min-width: 0;
}
.arena {
  display: grid;
}
.boss {
  overflow: hidden;
}
.boss img {
  position: absolute;
  width: 100%;
  height: 100%;
}
.boss .charge {
  clip-path: inset(100% 0 0);
  transition: clip-path .2s linear;
}
.meter {
  height: 22px;
  background: #273248;
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid #61718a;
}
.fill {
  height: 100%;
  width: 100%;
  background: linear-gradient(90deg,#20b89c,#9deacc);
  transition: width .8s;
}
.bosslife .fill {
  background: linear-gradient(90deg,#d94f41,#ffae55);
}
.question {
  border: 1px solid #344661;
  padding: 24px;
  border-radius: 18px;
  margin-top: 20px;
}
.question h2 {
  font-size: 25px;
  margin: 8px 0 20px;
}
.options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.option {
  padding: 15px;
  border-radius: 10px;
  border: 1px solid #526889;
}
.option.correct {
  border-color: #5ee2af;
}
.battery {
  border: 3px solid #708399;
  position: relative;
  border-radius: 13px;
  padding: 13px;
  overflow: hidden;
  margin: 15px 0;
  min-height: 90px;
}
.battery:before {
  content: '';
  position: absolute;
  right: 16px;
  top: 0;
  width: 30px;
  height: 5px;
  background: #a7bed3;
}
.battery .liquid {
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg,#115245,#197b60);
  transition: clip-path .8s;
  opacity: .8;
}
.battery .content {
  position: relative;
}
.students {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 8px;
}
.student {
  padding: 5px 8px;
  font-size: 12px;
}
.battery.attack {
  animation: hit .45s;
}
.status {
  font-size: 18px;
  min-height: 54px;
  padding: 12px 0;
}
.groups {
  display: grid;
}
.groups .battery {
  margin: 0;
}
.log {
  font-size: 13px;
  color: #b1c3dc;
  padding-top: 15px;
}
.timer {
  font-size: 24px;
  color: #ffb54f;
}
details {
  margin-top: 20px;
}
summary {
  cursor: pointer;
}
dialog {
  max-width: 680px;
  width: 95%;
  border: 1px solid #526889;
  border-radius: 15px;
  background: #10192b;
  color: white;
}
dialog::backdrop {
  background: #000b;
}
a {
  color: #9ecfff;
}
@keyframes hit {
  25% {
    transform: translateX(-7px);
    filter: brightness(1.8);
  }
  75% {
    transform: translateX(6px);
  }
}
@media(max-width:850px) {
  main {
    grid-template-columns: 1fr;
  }
  aside {
    border-right: 0;
  }
  section {
    padding: 15px;
  }
}
@media(prefers-reduced-motion:reduce) {
  * {
    animation: none!important;
    transition: none!important;
  }
}
input:disabled,select:disabled {
  opacity: .4;
  cursor: not-allowed;
}
.question {
  margin: 0 0 26px;
}
.battle-label {
  display: block;
  margin-bottom: 14px;
}
.battery-shell {
  position: relative;
  width: 100%;
  max-width: 550px;
  padding-top: 16px;
}
.battery-shell:before {
  content: '';
  position: absolute;
  left: 38%;
  width: 24%;
  border-radius: 7px 7px 0 0;
  border: 2px solid #8fa6b9;
}
#teamBattery {
  margin: 0;
  min-height: 410px;
  border-radius: 24px;
  padding: 20px;
}
#teamBattery:before {
  display: none;
}
#teamBattery>.content {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-height: 358px;
  justify-content: center;
}
#students {
  justify-content: center;
  margin: 0;
}
.student {
  min-width: 65px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 650;
}
.groups:empty {
  display: none;
}
.groups .battery {
  min-height: 135px;
}
.groups .students {
  justify-content: center;
}
.groups .student {
  font-size: 11px;
}
.groups .content strong {
  display: block;
  margin: 3px 0 8px;
}
.groups small {
  display: block;
  font-size: 11px;
  margin-top: 8px;
}
.groups .battery.shared-group {
  border: 1px solid #78aaa7;
}
.groups .battery.shared-group:before {
  display: none;
}
.groups .shared-group .liquid {
  display: none;
}
.bosslife {
  margin-bottom: 16px;
}
.team-note {
  display: block;
  text-align: center;
  margin-top: 12px;
}
@media(max-width:850px) {
  .boss {
    height: 410px;
  }
}
@media(max-width:480px) {
  #teamBattery {
    padding: 10px;
    border-width: 4px;
  }
  .groups {
    grid-template-columns: 1fr;
  }
  .question {
    padding: 16px;
  }
  .question h2 {
    font-size: 20px;
  }
  .options {
    grid-template-columns: 1fr;
  }
  .boss {
    height: 350px;
  }
  .student {
    min-width: 50px;
    font-size: 11px;
  }
  .boss-side small {
    font-size: 11px;
  }
}
section {
  background: radial-gradient(ellipse at 80% 70%,#083c4d80,transparent 65%),#071321;
}
.question {
  border-color: #396778;
  background: linear-gradient(120deg,#142b40,#101d32);
}
.arena {
